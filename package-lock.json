{
  "name": "rittick-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rittick-workspace",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": "^22 || ^24"
      }
    },
    "node_modules/@rittick/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/ui": {
      "name": "@rittick/ui",
      "version": "0.0.0",
      "engines": {
        "node": "^22 || ^24"
      }
    }
  }
}
