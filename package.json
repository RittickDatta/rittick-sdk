{
  "name": "rittick-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22 || ^24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:workspace": "node scripts/check-workspace.mjs",
    "typecheck": "tsc --project packages/ui/tsconfig.json --noEmit",
    "build": "npm run build --workspace=@rittick/ui",
    "check:package": "node scripts/check-ui-package.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
