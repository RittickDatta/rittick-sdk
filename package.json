
{
  "name": "rittick-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22 || ^24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:workspace": "node scripts/check-workspace.mjs",
    "typecheck": "tsc --project packages/ui/tsconfig.json --noEmit",
    "build": "npm run build --workspace=@rittick/ui",
    "check:package": "node scripts/check-ui-package.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
